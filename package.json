{
  "name": "form-shift",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "npm run test:actions && npm run test:copy && npm run test:history && npm run test:backend && npm run test:sites",
    "test:actions": "node --test tests/async-action-gate.test.mjs",
    "test:copy": "node --test tests/persistence-copy.test.mjs",
    "test:history": "node --test tests/history-utils.test.mjs tests/calendar-metrics.test.mjs",
    "test:backend": "node --test tests/backend-*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.mjs",
    "db:seed": "node scripts/seed-demo-data.mjs",
    "db:seed:reset": "node scripts/seed-demo-data.mjs --reset"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.2.8",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10"
  }
}
