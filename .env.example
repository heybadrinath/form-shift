# Neon pooled Postgres connection string. Keep the real value in local/Vercel secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Set a private four-digit owner PIN in local/Vercel secrets. Do not commit it.
OWNER_PIN=replace-with-four-digits

# Generate an independent random value of at least 32 characters.
AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
